                        <p>עם ג'קוזי פרטי ונוף מדהים</p>
                    </div>
                </a>

                <a href="https://res.cloudinary.com/dptyfvwyo/image/upload/v1760818996/Zimmer1_buveb2.jpg" 
                   class="gallery-item" 
                   data-category="zimmer">
                    <span class="gallery-badge">צימר</span>
                    <img src="https://res.cloudinary.com/dptyfvwyo/image/upload/w_600,q_auto,f_auto/v1760818996/Zimmer1_buveb2.jpg" 
                         alt="צימר כפרי ומפנק" 
                         loading="lazy">
                    <div class="gallery-overlay">
                        <h3>צימר כפרי</h3>
                        <p>בריחה רומנטית לטבע</p>
                    </div>
                </a>

                <!-- Apartment Items -->
                <a href="https://res.cloudinary.com/dptyfvwyo/image/upload/v1760818934/21_f14cql.jpg" 
                   class="gallery-item" 
                   data-category="apartment">
                    <span class="gallery-badge">דירת נופש</span>
                    <img src="https://res.cloudinary.com/dptyfvwyo/image/upload/w_600,q_auto,f_auto/v1760818934/21_f14cql.jpg" 
                         alt="דירת נופש עם נוף לים" 
                         loading="lazy">
                    <div class="gallery-overlay">
                        <h3>דירת נופש</h3>
                        <p>עם נוף פנורמי לים</p>
                    </div>
                </a>

                <a href="https://res.cloudinary.com/dptyfvwyo/image/upload/v1760818934/22_tt9jvz.jpg" 
                   class="gallery-item" 
                   data-category="apartment">
                    <img src="https://res.cloudinary.com/dptyfvwyo/image/upload/w_600,q_auto,f_auto/v1760818934/22_tt9jvz.jpg" 
                         alt="סלון מרווח" 
                         loading="lazy">
                    <div class="gallery-overlay">
                        <h3>סלון מרווח</h3>
                        <p>עיצוב מודרני ויוקרתי</p>
                    </div>
                </a>

                <a href="https://res.cloudinary.com/dptyfvwyo/image/upload/v1760818934/20_t6yw8m.jpg" 
                   class="gallery-item" 
                   data-category="apartment">
                    <span class="gallery-badge">פנטהאוז</span>
                    <img src="https://res.cloudinary.com/dptyfvwyo/image/upload/w_600,q_auto,f_auto/v1760818934/20_t6yw8m.jpg" 
                         alt="פנטהאוז מפואר" 
                         loading="lazy">
                    <div class="gallery-overlay">
                        <h3>פנטהאוז מפואר</h3>
                        <p>עם מרפסת גדולה</p>
                    </div>
                </a>

                <a href="https://res.cloudinary.com/dptyfvwyo/image/upload/v1760818933/18_uwsdum.jpg" 
                   class="gallery-item" 
                   data-category="apartment">
                    <img src="https://res.cloudinary.com/dptyfvwyo/image/upload/w_600,q_auto,f_auto/v1760818933/18_uwsdum.jpg" 
                         alt="חדר שינה" 
                         loading="lazy">
                    <div class="gallery-overlay">
                        <h3>חדר שינה יוקרתי</h3>
                        <p>נוחות מקסימלית</p>
                    </div>
                </a>

                <a href="https://res.cloudinary.com/dptyfvwyo/image/upload/v1760818932/2_d3zuys.jpg" 
                   class="gallery-item" 
                   data-category="apartment">
                    <img src="https://res.cloudinary.com/dptyfvwyo/image/upload/w_600,q_auto,f_auto/v1760818932/2_d3zuys.jpg" 
                         alt="דירה מודרנית" 
                         loading="lazy">
                    <div class="gallery-overlay">
                        <h3>דירה מודרנית</h3>
                        <p>להשכרה לטווח קצר</p>
                    </div>
                </a>

                <a href="https://res.cloudinary.com/dptyfvwyo/image/upload/v1760818932/1_cfch2y.jpg" 
                   class="gallery-item" 
                   data-category="apartment">
                    <img src="https://res.cloudinary.com/dptyfvwyo/image/upload/w_600,q_auto,f_auto/v1760818932/1_cfch2y.jpg" 
                         alt="דירת נופש מאובזרת" 
                         loading="lazy">
                    <div class="gallery-overlay">
                        <h3>דירת נופש מאובזרת</h3>
                        <p>כל מה שצריך לנופש מושלם</p>
                    </div>
                </a>

                <a href="https://res.cloudinary.com/dptyfvwyo/image/upload/v1760818934/13_s7ude8.jpg" 
                   class="gallery-item" 
                   data-category="apartment">
                    <img src="https://res.cloudinary.com/dptyfvwyo/image/upload/w_600,q_auto,f_auto/v1760818934/13_s7ude8.jpg" 
                         alt="מטבח מודרני" 
                         loading="lazy">
                    <div class="gallery-overlay">
                        <h3>מטבח מודרני</h3>
                        <p>מאובזר במכשירי חשמל מתקדמים</p>
                    </div>
                </a>

                <a href="https://res.cloudinary.com/dptyfvwyo/image/upload/v1760818932/15_o9ap5v.jpg" 
                   class="gallery-item" 
                   data-category="apartment">
                    <img src="https://res.cloudinary.com/dptyfvwyo/image/upload/w_600,q_auto,f_auto/v1760818932/15_o9ap5v.jpg" 
                         alt="חדר רחצה מפנק" 
                         loading="lazy">
                    <div class="gallery-overlay">
                        <h3>חדר רחצה מפנק</h3>
                        <p>עיצוב ספא-פרטי</p>
                    </div>
                </a>

                <!-- Hotel Item -->
                <a href="https://res.cloudinary.com/dptyfvwyo/image/upload/v1760818995/Hotel1_ihkey7.jpg" 
                   class="gallery-item" 
                   data-category="hotel">
                    <span class="gallery-badge">מלון בוטיק</span>
                    <img src="https://res.cloudinary.com/dptyfvwyo/image/upload/w_600,q_auto,f_auto/v1760818995/Hotel1_ihkey7.jpg" 
                         alt="מלון בוטיק" 
                         loading="lazy">
                    <div class="gallery-overlay">
                        <h3>מלון בוטיק יוקרתי</h3>
                        <p>חוויית אירוח ברמה גבוהה</p>
                    </div>
                </a>
            </div>
        </section>
    </main>

    <footer>
        <a href="/" class="footer-logo">
            <img src="https://github.com/kfischi/MULTIBRAWN-V.1/raw/main/Gallery/לוגו2.png" alt="MULTIBRAWN לוגו">
            <span>MULTIBRAWN</span>
        </a>
        <nav class="footer-links">
            <a href="privacy.html">מדיניות פרטיות</a>
            <a href="accessibility.html">הצהרת נגישות</a>
            <a href="about.html">אודות</a>
            <a href="contact.html">צור קשר</a>
        </nav>
        <p class="footer-copy">© 2025 MULTIBRAWN. כל הזכויות שמורות.</p>
    </footer>

    <!-- WhatsApp Float Button -->
    <a href="https://wa.me/972523983394" class="whatsapp-float" target="_blank" aria-label="צור קשר בווטסאפ">
        <i class="fab fa-whatsapp"></i>
    </a>

    <!-- Lightbox Modal -->
    <div class="lightbox" id="lightbox">
        <button class="lightbox-close" id="lightboxClose">&times;</button>
        <img src="" alt="תמונה מוגדלת" id="lightboxImg">
    </div>

    <script>
        // Header scroll effect
        const header = document.getElementById('header');
        window.addEventListener('scroll', () => {
            header.classList.toggle('scrolled', window.pageYOffset > 100);
        }, { passive: true });

        // Filter functionality
        const filterBtns = document.querySelectorAll('.filter-btn');
        const galleryItems = document.querySelectorAll('.gallery-item');

        filterBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                // Update active button
                filterBtns.forEach(b => b.classList.remove('active'));
                btn.classList.add('active');

                // Filter items
                const category = btn.dataset.filter;
                galleryItems.forEach(item => {
                    if (category === 'all' || item.dataset.category === category) {
                        item.classList.remove('hidden');
                    } else {
                        item.classList.add('hidden');
                    }
                });
            });
        });

        // Lightbox functionality
        const lightbox = document.getElementById('lightbox');
        const lightboxImg = document.getElementById('lightboxImg');
        const lightboxClose = document.getElementById('lightboxClose');

        galleryItems.forEach(item => {
            item.addEventListener('click', (e) => {
                e.preventDefault();
                const imgSrc = item.getAttribute('href');
                lightboxImg.src = imgSrc;
                lightbox.classList.add('active');
            });
        });

        lightboxClose.addEventListener('click', () => {
            lightbox.classList.remove('active');
        });

        lightbox.addEventListener('click', (e) => {
            if (e.target === lightbox) {
                lightbox.classList.remove('active');
            }
        });

        // Close lightbox with Escape key
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && lightbox.classList.contains('active')) {
                lightbox.classList.remove('active');
            }
        });
    </script>
</body>
</html>
