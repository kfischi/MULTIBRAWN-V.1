            <button class="filter-btn" data-filter="apartment">דירות נופש</button>
            <button class="filter-btn" data-filter="zimmer">צימרים</button>
        </div>

        <!-- Gallery Grid -->
        <section class="gallery-container">
            <div class="gallery-grid" id="galleryGrid">
                <!-- Zimmer Items -->
                <a href="https://res.cloudinary.com/dptyfvwyo/image/upload/v1760818996/Zimmer2_ge7g6h.jpg" 
                   class="gallery-item" 
                   data-category="zimmer">
                    <span class="gallery-badge">צימר</span>
                    <img src="https://res.cloudinary.com/dptyfvwyo/image/upload/w_600,q_auto,f_auto/v1760818996/Zimmer2_ge7g6h.jpg" 
                         alt="צימר יוקרתי עם ג'קוזי" 
